{
  "name": "kubermeister",
  "version": "0.1.1",
  "description": "Desktop Kubernetes client",
  "private": true,
  "license": "MIT",
  "author": "Ararat Poghosyan",
  "homepage": "https://github.com/araratpoghosyan/kubermeister#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/araratpoghosyan/kubermeister.git"
  },
  "bugs": {
    "url": "https://github.com/araratpoghosyan/kubermeister/issues"
  },
  "type": "module",
  "main": "./out/main/index.mjs",
  "engines": {
    "node": ">=24",
    "npm": ">=11.19"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "node scripts/check-electron-notices.mjs && electron-builder --config electron-builder.yml --publish never",
    "package:dir": "node scripts/check-electron-notices.mjs && electron-builder --config electron-builder.yml --publish never --dir",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "electron-updater": "^6.8.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testcontainers/k3s": "^12.1.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^44.3.0",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
